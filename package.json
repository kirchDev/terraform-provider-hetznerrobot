{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "terraform-provider-hetznerrobot",
  "version": "0.0.0",
  "description": "OpenTofu / Terraform provider for Hetzner Robot (dedicated servers).",
  "keywords": [
    "dedicated-server",
    "hetzner",
    "hetzner-robot",
    "iac",
    "infrastructure-as-code",
    "kirchdev",
    "opentofu",
    "terraform",
    "terraform-provider"
  ],
  "homepage": "https://github.com/kirchDev/terraform-provider-hetznerrobot#readme",
  "bugs": {
    "url": "https://github.com/kirchDev/terraform-provider-hetznerrobot/issues"
  },
  "license": "MIT",
  "author": "Titus Kirch <titus.kirch@kirch.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kirchDev/terraform-provider-hetznerrobot.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm check:policy",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "check:policy": "node scripts/check-policy-parity.ts",
    "skills:update": "pnpm dlx skills@latest update -p -y",
    "taze": "taze",
    "taze:w": "taze -w",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@commitlint/types": "^21.2.0",
    "@types/node": "^26.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "taze": "^21.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
